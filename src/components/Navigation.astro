---
import { LINKS, localeHref, type PageKey } from "../config/links";
import { useTranslations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);
---

<div class="relative flex justify-center px-10 md:px-0">
  <div class="glass flex flex-wrap gap-1 justify-center rounded-full p-1.5 backdrop-blur-md">
    {
      LINKS.map((link) => (
        <a
          href={localeHref(locale, link.url)}
          class:list={[
            "py-1 px-3.5 font-mono text-xs leading-5 uppercase tracking-wider rounded-full transition-all",
            link.name === page
              ? "font-semibold text-slate-900 bg-linear-100 from-accent to-accent-2 shadow-[0_0_14px_rgb(45_212_191/0.45)]"
              : "text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-900/5 dark:hover:bg-white/10",
          ]}
          aria-current={link.name === page ? "page" : undefined}
        >
          {t(`navigation.${link.name}`)}
        </a>
      ))
    }
  </div>
</div>
