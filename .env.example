# ── Public site config ─────────────────────────────────────────────────────────
# These values are rendered into the static HTML at build time (they are public
# by nature — .env keeps them configurable in one place, not secret).
# Changing them requires a rebuild + redeploy.

# Canonical site URL used for SEO tags (canonical, hreflang, OG, sitemap).
# After the first `npm run deploy`, wrangler prints your real workers.dev URL —
# put it here. Replace with your custom domain once attached.
PUBLIC_SITE_URL="https://personal-page-2026.workers.dev"

# Contact + social links (footer)
PUBLIC_CONTACT_EMAIL="janbauer.cv@gmail.com"
PUBLIC_LINKEDIN_URL="https://linkedin.com/in/jan-bauer-b21735b5"
PUBLIC_GITHUB_URL="https://github.com/MrSchnitz"
PUBLIC_YOUTUBE_URL="https://www.youtube.com/@janbauer9576"

# ── Cloudflare deploy credentials (OPTIONAL — real secrets, never committed) ───
# Default deploy flow is `wrangler login` (OAuth); nothing needs to be stored.
# Set these only for token-based/headless deploys; wrangler reads them from the
# environment. Create a token at https://dash.cloudflare.com/profile/api-tokens
# with the "Edit Cloudflare Workers" template.
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""
