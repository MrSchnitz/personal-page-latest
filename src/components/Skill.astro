---
interface Props {
  title: string;
  /** symbol id inside the sprite */
  icon: string;
  class?: string;
}

const { title, icon, class: className } = Astro.props;
const SPRITE = "/images/logos.svg";
---

<div
  title={title}
  class:list={[
    "glass flex flex-col items-center justify-center gap-2 w-24 h-24 rounded-2xl backdrop-blur-md",
    "transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_18px_rgb(45_212_191/0.3)]",
    className,
  ]}
>
  <svg class="w-10 h-10" role="img" aria-label={title}>
    <use href={`${SPRITE}#${icon}`}></use>
  </svg>
  <p class="max-w-22 truncate px-1 font-mono text-[10px] leading-none text-slate-600 dark:text-slate-300">
    {title}
  </p>
</div>
