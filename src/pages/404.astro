---
import { defaultLocale } from "../i18n";
import "../styles/global.css";
---

<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 – Jan Bauer</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <script is:inline>
      document.documentElement.classList.toggle(
        "dark",
        localStorage.getItem("COLOR_SCHEME") !== "light"
      );
    </script>
  </head>
  <body>
    <div class="flex flex-col items-center justify-center h-screen gap-4 text-neutral-800 dark:text-white">
      <h1 class="text-3xl font-bold tracking-wider">404</h1>
      <hr class="w-16 border-neutral-500 dark:border-gray-300" />
      <p class="text-lg text-center">Page not found · Stránka nenalezena</p>
      <a
        href={`/${defaultLocale}`}
        class="py-0.5 px-3 text-xs leading-6 uppercase rounded-full ring-1 hover:ring-2 transition-all text-neutral-700 dark:text-gray-200 ring-neutral-700 dark:ring-gray-200"
      >
        home
      </a>
    </div>
  </body>
</html>
