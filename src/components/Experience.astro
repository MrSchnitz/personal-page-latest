---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  logo: ImageMetadata;
  logoWhite: ImageMetadata;
  title: string;
  link: string;
  date: string;
  position: string;
  location: string;
  description: string[];
  class?: string;
}

const { logo, logoWhite, title, link, date, position, location, description, class: className } = Astro.props;
---

<div class:list={["flex flex-col md:flex-row md:items-start gap-2 md:gap-4", className]}>
  <a href={link} target="_blank" rel="noopener" class="shrink-0 self-center">
    <Image
      src={logo}
      alt=""
      width={150}
      class="w-37.5 h-auto object-contain transition-all duration-300 cursor-pointer hover:scale-105 dark:hidden"
    />
    <Image
      src={logoWhite}
      alt=""
      width={150}
      class="w-37.5 h-auto object-contain transition-all duration-300 cursor-pointer hover:scale-105 hidden dark:block"
    />
  </a>
  <div class="text-sm text-neutral-800 dark:text-white">
    <strong class="font-bold">{title}</strong>
    <p class="font-semibold">{position}</p>
    <p>{date}</p>
    <p>{location}</p>
    <ul class="list-disc list-inside">
      {description.map((line) => <li>{line}</li>)}
    </ul>
  </div>
</div>
