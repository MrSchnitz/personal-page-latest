---
import { LINKS, localeHref, type PageKey } from "../config/links";
import { useTranslations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);
---

<div class="relative flex flex-wrap gap-4 md:gap-2 justify-center leading-6 px-10 md:px-0">
  {
    LINKS.map((link) => (
      <a
        href={localeHref(locale, link.url)}
        class:list={[
          "py-0.5 px-3 text-xs leading-6 uppercase rounded-full",
          "ring-1 hover:ring-2 transition-all",
          "text-neutral-700 dark:text-gray-200 ring-neutral-700 dark:ring-gray-200",
          link.name === page &&
            "font-semibold ring-2 bg-neutral-700 text-gray-100! dark:bg-gray-200 dark:text-[#485563]!",
        ]}
        aria-current={link.name === page ? "page" : undefined}
      >
        {t(`navigation.${link.name}`)}
      </a>
    ))
  }
</div>
