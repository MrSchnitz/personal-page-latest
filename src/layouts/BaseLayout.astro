---
import { ClientRouter } from "astro:transitions";
import Seo from "../components/Seo.astro";
import spaceGrotesk400 from "@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url";
import spaceGrotesk700 from "@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url";
import sourceCodePro400 from "@fontsource/source-code-pro/files/source-code-pro-latin-400-normal.woff2?url";
import SceneBackground from "../components/SceneBackground.astro";
import Controls from "../components/Controls.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { hreflang, type Locale } from "../i18n";
import type { PageKey } from "../config/links";
import "../styles/global.css";

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
---

{/* transition:animate="none" kills the ClientRouter's default full-page
    crossfade — the 2023 site swapped the shell statically and only faded the
    page content in (.page-fade below). */}
<html lang={hreflang[locale]} class="dark" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* favicon package generated with RealFaviconGenerator (brand emerald </>) */}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Jan Bauer" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {/* critical latin fonts, preloaded so text paints in its final face ASAP */}
    {
      [spaceGrotesk400, spaceGrotesk700, sourceCodePro400].map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
      ))
    }
    <slot name="head" />
    <Seo locale={locale} page={page} />
    <ClientRouter />
    <script is:inline>
      // Theme + view-transition lifecycle. Runs before first paint (anti-FOUC):
      // default is dark, "light" in localStorage switches. astro:after-swap fires
      // synchronously before the new page paints — the swap resets <html>
      // attributes, so re-apply the theme and mark the intro as done (the intro
      // choreography only plays on full page loads).
      (function () {
        var apply = function () {
          document.documentElement.classList.toggle(
            "dark",
            localStorage.getItem("COLOR_SCHEME") !== "light"
          );
        };
        apply();
        document.addEventListener("astro:after-swap", function () {
          document.documentElement.classList.add("intro-done");
          apply();
        });
      })();
    </script>
  </head>
  <body>
    <SceneBackground />
    <Controls locale={locale} page={page} />
    <div
      class="flex flex-col items-center justify-center px-6 pb-6 md:px-0 md:py-6 w-full md:min-h-screen transition duration-1000 ease-in-out font-display text-slate-800 dark:text-slate-100"
    >
      {/* desktop: the panel caps at the viewport height and the framed content
          scrolls internally (min-h-0 down the chain lets flex children shrink),
          so the nav dock and footer never leave the screen */}
      <div class="md:relative md:flex md:flex-col md:max-h-[calc(100vh-3rem)] md:blur-bg md:py-3 md:px-4 md:rounded-3xl">
        <div
          class="sticky z-10 py-16 md:py-4 -mx-6 md:m-0 top-0 md:shrink-0 overflow-hidden md:overflow-visible navigation-scroll"
          data-nav-scroll
        >
          <Navigation locale={locale} page={page} />
        </div>
        <div
          class="flex flex-col items-center justify-center pt-2 md:pt-0 md:min-h-0 w-full md:min-w-basic-page-m lg:min-w-basic-page md:max-w-fit"
        >
          <div
            class="intro-frame flex flex-col items-center justify-center w-full mb-3 md:my-6 md:min-h-0 md:frame-line"
          >
            {/* .intro-collapse is a padding-less grid item so the intro's
                grid-template-rows: 0fr can truly reach zero height — with the
                padded .intro-content as the item, its padding held the borders
                ~4rem apart and the "line opens into a box" effect was lost.
                It is also the internal scroll container on desktop. */}
            <div class="intro-collapse w-full md:min-h-0 md:max-h-full md:overflow-y-auto">
              <div class="intro-content pb-8 md:py-8 md:px-2 w-full grid place-content-center">
                <div class="relative page-fade">
                  <slot />
                </div>
              </div>
            </div>
          </div>
          <div class="relative intro-footer md:shrink-0">
            <Footer />
          </div>
        </div>
      </div>
    </div>
    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
