{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-page-2026",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // serves dist/404.html with a 404 status (MPA-correct)
    "not_found_handling": "404-page",
    // the Worker only runs for "/" (Accept-Language redirect); everything else is served
    // straight from static assets without a Worker invocation
    "run_worker_first": ["/"]
  }
}
