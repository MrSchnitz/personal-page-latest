---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { asLocale, useTranslations, getLocaleStaticPaths } from "../../i18n";

export const getStaticPaths = getLocaleStaticPaths;

const locale = asLocale(Astro.params.locale);
const t = useTranslations(locale);
---

<BaseLayout locale={locale} page="about">
  <div class="md:px-4 w-full md:max-w-basic-page">
    <p class="mb-5 font-mono text-xs text-accent-deep dark:text-accent" aria-hidden="true">~$ cat about.md</p>
    <div class="mb-6 leading-relaxed text-slate-700 dark:text-slate-200 whitespace-pre-wrap">
      {t("pages.about.first")}
    </div>
    <div class="leading-relaxed text-slate-700 dark:text-slate-200">{t("pages.about.second")}</div>
  </div>
</BaseLayout>
