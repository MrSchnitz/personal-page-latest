---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Skill from "../../components/Skill.astro";
import { SKILLS } from "../../config/skills";
import { asLocale, getLocaleStaticPaths } from "../../i18n";

export const getStaticPaths = getLocaleStaticPaths;

const locale = asLocale(Astro.params.locale);
---

<BaseLayout locale={locale} page="skills">
  <div class="md:max-w-skills-page">
    <p class="mb-5 font-mono text-xs text-accent-deep dark:text-accent" aria-hidden="true">~$ ls skills/</p>
    <div class="flex flex-wrap gap-3 justify-center text-slate-700 dark:text-slate-200">
      {SKILLS.map((skill) => <Skill title={skill.title} icon={skill.icon} class={skill.class} />)}
    </div>
  </div>
</BaseLayout>
