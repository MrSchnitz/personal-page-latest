---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Education from "../../components/Education.astro";
import { EDUCATION } from "../../config/education";
import { asLocale, useTranslations, getLocaleStaticPaths } from "../../i18n";

export const getStaticPaths = getLocaleStaticPaths;

const locale = asLocale(Astro.params.locale);
const t = useTranslations(locale);
---

<BaseLayout locale={locale} page="education">
  {
    EDUCATION.map((education, index) => (
      <Education
        class={index < EDUCATION.length - 1 ? "mb-6" : undefined}
        link={education.link}
        logo={education.logo}
        title={t(`pages.education.${education.key}.title`)}
        study={t(`pages.education.${education.key}.study`)}
        location={t(`pages.education.${education.key}.location`)}
        program={t(`pages.education.${education.key}.program`)}
        specialization={t(`pages.education.${education.key}.specialization`)}
        year={t(`pages.education.${education.key}.year`)}
      />
    ))
  }
</BaseLayout>
